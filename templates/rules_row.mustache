{{!
    @template local_groupdist/rules_row

    One affinity rule row, rendered by the local_groupdist/rules AMD module.
    The priority number, labels and button titles carry the 1-based index; the
    connector chip appears on every row after the first.

    Context variables required for this template:
    * index - 1-based position (priority)
    * isapart - whether the current mode is keep-apart (row accent)
    * notfirst - whether the connector row is shown
    * isfirst / islast - disable the up/down buttons at the edges
    * sources - options for the source select (value, label, selected)
    * together / apart - selected flags for the mode select

    Example context (json):
    {
        "index": 2,
        "isapart": true,
        "notfirst": true,
        "isfirst": false,
        "islast": true,
        "together": false,
        "apart": true,
        "sources": [
            {"value": "city", "label": "City", "selected": true}
        ]
    }
}}
{{#notfirst}}
<div class="local-groupdist-ruleconnector small text-muted" aria-hidden="true">
    <span class="badge bg-light text-dark border fw-normal">{{#str}} ruleconnector, local_groupdist {{/str}}</span>
</div>
{{/notfirst}}
<div class="local-groupdist-rule d-flex align-items-center gap-2 border rounded p-2 {{#isapart}}local-groupdist-rule-apart{{/isapart}}"
    data-region="rule"
    draggable="true">
    <span class="local-groupdist-rulegrip text-muted" aria-hidden="true">⠿</span>
    <span class="local-groupdist-ruleprio badge rounded-pill {{#isapart}}text-bg-warning{{/isapart}}{{^isapart}}text-bg-success{{/isapart}}">{{index}}</span>
    <label class="visually-hidden" for="local-groupdist-rulesource-{{index}}">
        {{#str}} rulesourcelabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-rulesource-{{index}}" class="form-select form-select-sm w-auto flex-grow-1"
            data-action="source">
        <option value="">{{#str}} rulechoosesource, local_groupdist {{/str}}</option>
        {{#sources}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/sources}}
    </select>
    <label class="visually-hidden" for="local-groupdist-rulemode-{{index}}">
        {{#str}} rulemodelabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-rulemode-{{index}}" class="form-select form-select-sm w-auto" data-action="mode">
        <option value="together" {{#together}}selected{{/together}}>{{#str}} modetogether, local_groupdist {{/str}}</option>
        <option value="apart" {{#apart}}selected{{/apart}}>{{#str}} modeapart, local_groupdist {{/str}}</option>
    </select>
    <span class="d-flex gap-1">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="moveup" {{#isfirst}}disabled{{/isfirst}}
                aria-label="{{#str}} rulemoveup, local_groupdist, {{index}} {{/str}}">
            <i class="fa fa-arrow-up" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="movedown" {{#islast}}disabled{{/islast}}
                aria-label="{{#str}} rulemovedown, local_groupdist, {{index}} {{/str}}">
            <i class="fa fa-arrow-down" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="delete"
                aria-label="{{#str}} ruledelete, local_groupdist, {{index}} {{/str}}">
            <i class="fa fa-times" aria-hidden="true"></i>
        </button>
    </span>
</div>
