{{!
    @template local_groupdist/preview_groups

    One page of preview group cards, client-rendered from the preview web
    service. Percent values are server-computed integers, safe in the style
    attribute of the capacity meter.

    Context variables required for this template:
    * locationlabel - stored display name of the location custom field
    * groups - array of group entries: name, location, seats, current,
      allocated, total, overflow, hasseats, fillpct, spillpct, hiddencount, a
      members array (fullname, affinities badge list, enrolstart, isnew) and a
      rules status array (index, label, ok, text)

    Example context (json):
    {
        "locationlabel": "Location",
        "groups": [
            {
                "id": 12,
                "name": "Group 01",
                "location": "Room 101",
                "seats": 12,
                "current": 3,
                "allocated": 9,
                "total": 12,
                "overflow": 0,
                "hasseats": true,
                "fillpct": 100,
                "spillpct": 0,
                "hiddencount": 7,
                "members": [
                    {
                        "fullname": "Ana Souza",
                        "affinities": [
                            {"value": "Fortaleza", "apart": false},
                            {"value": "Cohort: Managers", "apart": true}
                        ],
                        "enrolstart": "starts 01/09/26",
                        "isnew": true
                    }
                ],
                "rules": [
                    {"index": 1, "label": "City", "ok": true, "text": "Fortaleza"},
                    {"index": 2, "label": "Gender", "ok": false, "text": "2 repeated"}
                ]
            }
        ]
    }
}}
{{#groups}}
<div class="card mb-2 local-groupdist-group" data-groupid="{{id}}">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-baseline gap-2 mb-1">
            <h3 class="h6 mb-0">{{name}}</h3>
            {{#location}}<span class="small text-muted">{{locationlabel}}: {{.}}</span>{{/location}}
            <span class="ms-auto small text-muted">
                {{#hasseats}}
                <strong class="text-body">{{total}}</strong> / {{seats}}
                {{#overflow}}<span class="text-warning fw-bold">(+{{.}})</span>{{/overflow}}
                {{/hasseats}}
                {{^hasseats}}
                {{#str}} groupnewmembers, local_groupdist, {{allocated}} {{/str}}
                {{/hasseats}}
            </span>
        </div>
        {{#hasseats}}
        <div class="progress local-groupdist-meter mb-2" role="img" aria-label="{{total}} / {{seats}}">
            <div class="progress-bar {{^overflow}}bg-primary{{/overflow}}{{#overflow}}bg-success{{/overflow}}"
                 style="width: {{fillpct}}%"></div>
            {{#overflow}}
            <div class="progress-bar progress-bar-striped bg-warning" style="width: {{spillpct}}%"></div>
            {{/overflow}}
        </div>
        {{/hasseats}}
        <ul class="list-unstyled local-groupdist-members mb-0">
            {{#members}}
            <li class="d-flex align-items-center gap-2">
                <i class="fa fa-user-circle-o text-muted" aria-hidden="true"></i>
                <span class="text-truncate">{{fullname}}</span>
                {{#isnew}}<span class="badge bg-success text-white">{{#str}} statusnew, local_groupdist {{/str}}</span>{{/isnew}}
                {{#enrolstart}}<span class="badge bg-light text-dark border fw-normal">{{.}}</span>{{/enrolstart}}
                <span class="ms-auto d-flex flex-wrap gap-1 justify-content-end">
                    {{#affinities}}
                    <span class="badge border fw-normal {{#apart}}bg-warning text-dark{{/apart}}{{^apart}}bg-light text-dark{{/apart}}">{{value}}</span>
                    {{/affinities}}
                </span>
            </li>
            {{/members}}
            {{#hiddencount}}
            <li class="small text-muted">{{#str}} membersnotshown, local_groupdist, {{.}} {{/str}}</li>
            {{/hiddencount}}
        </ul>
        {{#rules.0}}
        <div class="d-flex flex-wrap gap-3 border-top mt-2 pt-2 small text-muted local-groupdist-rulestatus">
            {{#rules}}
            <span>
                {{#ok}}<i class="fa fa-check text-success" aria-hidden="true"></i>{{/ok}}
                {{^ok}}<i class="fa fa-exclamation-triangle text-warning" aria-hidden="true"></i>{{/ok}}
                R{{index}} {{label}}{{#text}}: {{.}}{{/text}}
            </span>
            {{/rules}}
        </div>
        {{/rules.0}}
    </div>
</div>
{{/groups}}
