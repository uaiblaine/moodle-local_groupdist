{{!
    @template local_groupdist/selected_groups

    Chips summarising the groups selected on the group management page
    (first few names plus a counter chip for the rest).

    Context variables required for this template:
    * total - total number of selected groups
    * groups - array of objects with a name property (the sample shown)
    * morecount - how many further groups are not shown (0 hides the chip)

    Example context (json):
    {
        "total": 42,
        "groups": [
            {"name": "Group 01"},
            {"name": "Group 02"}
        ],
        "morecount": 40
    }
}}
<div class="card mb-3">
    <div class="card-body py-3">
        <h2 class="h6 text-muted">{{#str}} selectedgroups, local_groupdist, {{total}} {{/str}}</h2>
        <div class="d-flex flex-wrap gap-1">
            {{#groups}}
            <span class="badge bg-light text-dark border fw-normal">{{name}}</span>
            {{/groups}}
            {{#morecount}}
            <span class="badge bg-light text-muted border fw-normal">+{{morecount}}</span>
            {{/morecount}}
        </div>
        <p class="small text-muted mb-0 mt-2">{{#str}} selectedgroupsnote, local_groupdist {{/str}}</p>
    </div>
</div>
