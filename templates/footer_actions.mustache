{{!
    @template local_groupdist/footer_actions

    Sticky footer content of the preview page: apply form (fingerprint filled
    by the preview AMD module, button enabled once the first page loaded),
    back form and cancel link.

    Context variables required for this template:
    * applyurl - the apply endpoint
    * backurl - the options form URL (posted back with the chosen options)
    * cancelurl - the group management page
    * sesskey - session key
    * fields - array of name/value pairs, the canonical options

    Example context (json):
    {
        "applyurl": "https://example.com/local/groupdist/apply.php",
        "backurl": "https://example.com/local/groupdist/distribute.php?id=2",
        "cancelurl": "https://example.com/group/index.php?id=2",
        "sesskey": "abc123",
        "fields": [
            {"name": "seed", "value": "12345"}
        ]
    }
}}
<div class="d-flex flex-wrap align-items-center gap-2 w-100">
    <form method="post" action="{{applyurl}}" class="d-inline mb-0">
        {{#fields}}
        <input type="hidden" name="{{name}}" value="{{value}}">
        {{/fields}}
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="fingerprint" value="" data-region="fingerprint">
        <button type="submit" class="btn btn-primary" data-action="apply" disabled>
            {{#str}} applydistribution, local_groupdist {{/str}}
        </button>
    </form>
    <form method="post" action="{{backurl}}" class="d-inline mb-0">
        {{#fields}}
        <input type="hidden" name="{{name}}" value="{{value}}">
        {{/fields}}
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="back" value="1">
        <button type="submit" class="btn btn-secondary">{{#str}} backadjust, local_groupdist {{/str}}</button>
    </form>
    <a href="{{cancelurl}}" class="btn btn-link">{{#str}} cancel, core {{/str}}</a>
</div>
