{{!
    @template local_groupdist/rules_row

    One affinity rule row, rendered by the local_groupdist/rules AMD module.
    The type select decides the second control, which is always driven by the
    same options list: a profile-field select, a cohort select or a course
    group select — or, when that kind's picker is in search mode, either a
    search box whose suggestions the AMD module fills from the matching search
    web service, or, once a value is chosen, that value as a chip with a clear
    button. The two are exclusive: leaving the box beside the chip made it look
    as though nothing had been selected, and there was no way back to the box
    except deleting the whole rule. A group option may arrive disabled: a group this run distributes
    INTO cannot constrain anything while the "ignore users already in the
    selected groups" filter is on, because every member carrying the value has
    already been filtered out of the run. The priority number, labels and
    button titles carry the 1-based index; the connector chip appears on every
    row after the first.

    Context variables required for this template:
    * index - 1-based position (priority)
    * isapart - whether the current mode is keep-apart (row accent)
    * notfirst - whether the connector row is shown
    * isfirst / islast - disable the up/down buttons at the edges
    * isfield / iscohort / isgroup - which source type is selected (exactly one)
    * searchmode - whether the selected type's picker is a search box
    * chosenlabel - label of the current pick; when set, search mode shows the
      chip and its clear button instead of the search box
    * query - current search text
    * options - options for the source select (value, label, selected, disabled)
    * together / apart - selected flags for the mode select

    Example context (json):
    {
        "index": 2,
        "isapart": true,
        "notfirst": true,
        "isfirst": false,
        "islast": true,
        "isfield": false,
        "iscohort": false,
        "isgroup": true,
        "searchmode": false,
        "chosenlabel": "",
        "query": "",
        "together": false,
        "apart": true,
        "options": [
            {"value": "group_7", "label": "Lab team 2026.1", "selected": true, "disabled": false},
            {"value": "group_9", "label": "Group 01 - a destination of this run (unavailable)",
             "selected": false, "disabled": true}
        ]
    }
}}
{{#notfirst}}
<div class="local-groupdist-ruleconnector small text-muted" aria-hidden="true">
    <span class="badge bg-light text-dark border fw-normal">{{#str}} ruleconnector, local_groupdist {{/str}}</span>
</div>
{{/notfirst}}
<div class="local-groupdist-rule d-flex flex-wrap align-items-center gap-2 border rounded p-2 {{#isapart}}local-groupdist-rule-apart{{/isapart}}"
    data-region="rule"
    draggable="true">
    <span class="local-groupdist-rulegrip text-muted" aria-hidden="true">&#10303;</span>
    <span class="local-groupdist-ruleprio badge rounded-pill {{#isapart}}text-bg-warning{{/isapart}}{{^isapart}}text-bg-success{{/isapart}}">{{index}}</span>
    <label class="visually-hidden" for="local-groupdist-ruletype-{{index}}">
        {{#str}} ruletypelabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-ruletype-{{index}}" class="form-select form-select-sm w-auto" data-action="kind">
        <option value="field" {{#isfield}}selected{{/isfield}}>{{#str}} ruletypefield, local_groupdist {{/str}}</option>
        <option value="cohort" {{#iscohort}}selected{{/iscohort}}>{{#str}} ruletypecohort, local_groupdist {{/str}}</option>
        <option value="group" {{#isgroup}}selected{{/isgroup}}>{{#str}} ruletypegroup, local_groupdist {{/str}}</option>
    </select>
    {{#isfield}}
    <label class="visually-hidden" for="local-groupdist-rulesource-{{index}}">
        {{#str}} rulefieldlabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-rulesource-{{index}}" class="form-select form-select-sm w-auto flex-grow-1"
            data-action="source">
        <option value="">{{#str}} rulechoosefield, local_groupdist {{/str}}</option>
        {{#options}}
        <option value="{{value}}" {{#selected}}selected{{/selected}} {{#disabled}}disabled{{/disabled}}>{{label}}</option>
        {{/options}}
    </select>
    {{/isfield}}
    {{#iscohort}}
    {{^searchmode}}
    <label class="visually-hidden" for="local-groupdist-rulesource-{{index}}">
        {{#str}} rulecohortlabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-rulesource-{{index}}" class="form-select form-select-sm w-auto flex-grow-1"
            data-action="source">
        <option value="">{{#str}} rulechoosecohort, local_groupdist {{/str}}</option>
        {{#options}}
        <option value="{{value}}" {{#selected}}selected{{/selected}} {{#disabled}}disabled{{/disabled}}>{{label}}</option>
        {{/options}}
    </select>
    {{/searchmode}}
    {{#searchmode}}
    <span class="position-relative flex-grow-1 local-groupdist-sourcepick" data-region="sourcepick">
        {{#chosenlabel}}
        <span class="badge bg-light text-dark border fw-normal local-groupdist-sourcechosen"
              data-region="sourcechosen">
            <span class="text-truncate">{{.}}</span>
            <button type="button" class="btn btn-link btn-sm p-0 local-groupdist-sourceclear"
                    data-action="clearsource"
                    aria-label="{{#str}} ruleclearsource, local_groupdist, {{index}} {{/str}}">
                <i class="fa fa-times" aria-hidden="true"></i>
            </button>
        </span>
        {{/chosenlabel}}
        {{^chosenlabel}}
        <label class="visually-hidden" for="local-groupdist-rulesearch-{{index}}">
            {{#str}} rulecohortsearchlabel, local_groupdist, {{index}} {{/str}}
        </label>
        <input type="text" id="local-groupdist-rulesearch-{{index}}"
               class="form-control form-control-sm w-100"
               data-action="sourcesearch" autocomplete="off"
               placeholder="{{#str}} rulechoosecohort, local_groupdist {{/str}}" value="{{query}}">
        <span class="list-group position-absolute local-groupdist-sourceresults" data-region="sourceresults"
              role="listbox" hidden></span>
        {{/chosenlabel}}
    </span>
    {{/searchmode}}
    {{/iscohort}}
    {{#isgroup}}
    {{^searchmode}}
    <label class="visually-hidden" for="local-groupdist-rulesource-{{index}}">
        {{#str}} rulegrouplabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-rulesource-{{index}}" class="form-select form-select-sm w-auto flex-grow-1"
            data-action="source">
        <option value="">{{#str}} rulechoosegroup, local_groupdist {{/str}}</option>
        {{#options}}
        <option value="{{value}}" {{#selected}}selected{{/selected}} {{#disabled}}disabled{{/disabled}}>{{label}}</option>
        {{/options}}
    </select>
    {{/searchmode}}
    {{#searchmode}}
    <span class="position-relative flex-grow-1 local-groupdist-sourcepick" data-region="sourcepick">
        {{#chosenlabel}}
        <span class="badge bg-light text-dark border fw-normal local-groupdist-sourcechosen"
              data-region="sourcechosen">
            <span class="text-truncate">{{.}}</span>
            <button type="button" class="btn btn-link btn-sm p-0 local-groupdist-sourceclear"
                    data-action="clearsource"
                    aria-label="{{#str}} ruleclearsource, local_groupdist, {{index}} {{/str}}">
                <i class="fa fa-times" aria-hidden="true"></i>
            </button>
        </span>
        {{/chosenlabel}}
        {{^chosenlabel}}
        <label class="visually-hidden" for="local-groupdist-rulesearch-{{index}}">
            {{#str}} rulegroupsearchlabel, local_groupdist, {{index}} {{/str}}
        </label>
        <input type="text" id="local-groupdist-rulesearch-{{index}}"
               class="form-control form-control-sm w-100"
               data-action="sourcesearch" autocomplete="off"
               placeholder="{{#str}} rulechoosegroup, local_groupdist {{/str}}" value="{{query}}">
        <span class="list-group position-absolute local-groupdist-sourceresults" data-region="sourceresults"
              role="listbox" hidden></span>
        {{/chosenlabel}}
    </span>
    {{/searchmode}}
    {{/isgroup}}
    <label class="visually-hidden" for="local-groupdist-rulemode-{{index}}">
        {{#str}} rulemodelabel, local_groupdist, {{index}} {{/str}}
    </label>
    <select id="local-groupdist-rulemode-{{index}}" class="form-select form-select-sm w-auto" data-action="mode">
        <option value="together" {{#together}}selected{{/together}}>{{#str}} modetogether, local_groupdist {{/str}}</option>
        <option value="apart" {{#apart}}selected{{/apart}}>{{#str}} modeapart, local_groupdist {{/str}}</option>
    </select>
    <span class="d-flex gap-1">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="moveup" {{#isfirst}}disabled{{/isfirst}}
                aria-label="{{#str}} rulemoveup, local_groupdist, {{index}} {{/str}}">
            <i class="fa fa-arrow-up" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="movedown" {{#islast}}disabled{{/islast}}
                aria-label="{{#str}} rulemovedown, local_groupdist, {{index}} {{/str}}">
            <i class="fa fa-arrow-down" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="delete"
                aria-label="{{#str}} ruledelete, local_groupdist, {{index}} {{/str}}">
            <i class="fa fa-times" aria-hidden="true"></i>
        </button>
    </span>
</div>
