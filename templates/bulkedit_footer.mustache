{{!
    @template local_groupdist/bulkedit_footer

    Sticky footer of the bulk edit page: save (chunked via web service),
    cancel, unsaved-changes counter.

    Context variables required for this template:
    * cancelurl - the group management page URL

    Example context (json):
    {
        "cancelurl": "https://example.com/group/index.php?id=2"
    }
}}
<div class="d-flex flex-wrap align-items-center gap-2 w-100">
    <button type="button" class="btn btn-primary" data-action="save" disabled>
        {{#str}} savechanges, core {{/str}}
    </button>
    <a href="{{cancelurl}}" class="btn btn-link">{{#str}} cancel, core {{/str}}</a>
    <span class="small fw-bold local-groupdist-dirtycount" data-region="dirtycount" role="status"></span>
</div>
