{{!
    @template local_groupdist/rules_builder

    Affinity rule builder mount, embedded in the options form. The AMD module
    local_groupdist/rules renders the rows, keeps the flattened hidden inputs
    in sync and handles add/remove/reorder. Rules are summed (implicit AND);
    list position is the priority.

    Context variables required for this template:
    * sourcesjson - JSON list of value/label source options
    * rulesjson - JSON list of initial rules (source and mode keys)
    * maxrules - guardrail maximum number of rules

    Example context (json):
    {
        "sourcesjson": "[{\"value\":\"city\",\"label\":\"City\"}]",
        "rulesjson": "[{\"source\":\"city\",\"mode\":\"together\"}]",
        "maxrules": 10
    }
}}
<div class="local-groupdist-rules"
     data-region="local-groupdist-rules"
     data-sources="{{sourcesjson}}"
     data-rules="{{rulesjson}}"
     data-maxrules="{{maxrules}}">
    <div class="mb-2" data-region="rows"></div>
    <div data-region="inputs"></div>
    <div class="d-flex align-items-center gap-2 mb-2">
        <button type="button" class="btn btn-secondary btn-sm" data-action="addrule">
            {{#str}} addrule, local_groupdist {{/str}}
        </button>
    </div>
    <div class="alert alert-info d-flex gap-2 small mb-0" role="note">
        <i class="fa fa-info-circle mt-1" aria-hidden="true"></i>
        <span>{{#str}} rulesprioritynote, local_groupdist {{/str}}</span>
    </div>
</div>
