{{!
    @template local_groupdist/preview_groups

    One page of preview group cards, client-rendered from the preview web
    service. Percent values are server-computed integers, safe in the style
    attribute of the capacity meter.

    Context variables required for this template:
    * groups - array of group entries: name, location, seats, current,
      allocated, total, overflow, hasseats, fillpct, spillpct, hiddencount and
      a members array (fullname, affinity, isnew)

    Example context (json):
    {
        "groups": [
            {
                "id": 12,
                "name": "Group 01",
                "location": "Room 101",
                "seats": 12,
                "current": 3,
                "allocated": 9,
                "total": 12,
                "overflow": 0,
                "hasseats": true,
                "fillpct": 100,
                "spillpct": 0,
                "hiddencount": 7,
                "members": [
                    {"fullname": "Ana Souza", "affinity": "Fortaleza", "isnew": true}
                ]
            }
        ]
    }
}}
{{#groups}}
<div class="card mb-2 local-groupdist-group" data-groupid="{{id}}">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-baseline gap-2 mb-1">
            <h3 class="h6 mb-0">{{name}}</h3>
            {{#location}}<span class="small text-muted">{{#str}} grouplocation, local_groupdist, {{.}} {{/str}}</span>{{/location}}
            <span class="ms-auto small text-muted">
                {{#hasseats}}
                <strong class="text-body">{{total}}</strong> / {{seats}}
                {{#overflow}}<span class="text-warning fw-bold">(+{{.}})</span>{{/overflow}}
                {{/hasseats}}
                {{^hasseats}}
                {{#str}} groupnewmembers, local_groupdist, {{allocated}} {{/str}}
                {{/hasseats}}
            </span>
        </div>
        {{#hasseats}}
        <div class="progress local-groupdist-meter mb-2" role="img" aria-label="{{total}} / {{seats}}">
            <div class="progress-bar {{^overflow}}bg-primary{{/overflow}}{{#overflow}}bg-success{{/overflow}}"
                 style="width: {{fillpct}}%"></div>
            {{#overflow}}
            <div class="progress-bar progress-bar-striped bg-warning" style="width: {{spillpct}}%"></div>
            {{/overflow}}
        </div>
        {{/hasseats}}
        <ul class="list-unstyled local-groupdist-members mb-0">
            {{#members}}
            <li class="d-flex align-items-center gap-2">
                <i class="fa fa-user-circle-o text-muted" aria-hidden="true"></i>
                <span class="text-truncate">{{fullname}}</span>
                {{#isnew}}<span class="badge bg-success text-white">{{#str}} statusnew, local_groupdist {{/str}}</span>{{/isnew}}
                {{#affinity}}<span class="badge bg-light text-dark border fw-normal ms-auto">{{.}}</span>{{/affinity}}
            </li>
            {{/members}}
            {{#hiddencount}}
            <li class="small text-muted">{{#str}} membersnotshown, local_groupdist, {{.}} {{/str}}</li>
            {{/hiddencount}}
        </ul>
    </div>
</div>
{{/groups}}
